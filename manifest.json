{
  "manifest_version": 3,
  "name": "CourseMOS PDF Viewer",
  "version": "1.1.4",
  "minimum_chrome_version": "128",
  "description": "Open PDFs from CourseMOS-based LMS sites, including POSTECH LMS in a new browser tab. Toggle on or off anytime.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://plms.postech.ac.kr/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CourseMOS PDF Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
